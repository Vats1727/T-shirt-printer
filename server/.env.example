# Example Postgres connection settings. Copy to `.env` and fill in values.
# You can either set DATABASE_URL directly, or set the DB_* variables below.

# Option A: single connection string
# DATABASE_URL=postgres://user:password@localhost:5432/tshirt_printer

# Option B: components (used when DATABASE_URL is not set)
# DB_USER=myuser
# DB_PASSWORD=mypassword
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=tshirt_printer

# Server configuration
# PORT=5000
# NODE_ENV=development

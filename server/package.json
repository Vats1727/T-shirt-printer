{
  "name": "tshirt-printer-server",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx index.ts",
    "server:dev": "cross-env NODE_ENV=development SKIP_VITE=1 tsx index.ts",
    "client:dev": "node ./node_modules/vite/bin/vite.js --config ../client/vite.config.ts",
    "build": "tsx script/build.ts",
    "start": "npm run server:dev",
    "smoke": "cross-env NODE_ENV=test tsx script/smoke-tests.ts",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "db:import-json": "tsx script/import-json-to-db.ts",
    "db:setup": "npm run db:push && npm run db:import-json"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.0",
    "dotenv": "^16.1.4",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.0",
    "nanoid": "^4.0.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.3",
    "wouter": "^3.3.5",
    "ws": "^8.18.0",
    "zod": "^3.24.2",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.7",
    "@types/pg": "^8.16.0",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.5",
    "typescript": "5.6.3",
    "vite": "^7.3.0"
  }
}
